# Copia este archivo como server/.env y completa los valores. NO subas .env a Git.

# Fotos: Unsplash (principal) y/o Pexels (respaldo). Basta con una de las dos.
# Unsplash: https://unsplash.com/developers  → New Application → Access Key
UNSPLASH_ACCESS_KEY=
# Pexels (gratis, sin tarjeta): https://www.pexels.com/api/
PEXELS_API_KEY=

# Nominatim exige identificar tu aplicación (nombre + contacto). Pon tu correo real.
NOMINATIM_USER_AGENT=MotoRutaWeb/1.0 (proyecto academico; tu-correo@ejemplo.com)

# --- Lugares agregados a mano (Postgres gratuito: Neon o Supabase) ---
# Pega aquí la cadena de conexión que te da el proveedor. Si la dejas vacía, la app funciona igual sin esta función.
DATABASE_URL=
# Clave del panel /admin.html (mínimo 8 caracteres). Sin ella, el panel queda deshabilitado.
ADMIN_PASSWORD=

# --- Opcionales ---
PORT=3000
CACHE_TTL_SECONDS=300
RATE_LIMIT_MAX=20
SEARCH_RADIUS_METERS=3000

# Modo demostración: devuelve datos de ejemplo sin llamar a ninguna API (útil sin internet)
# DEMO_MODE=true

# DATABASE_SSL=false   # solo si tu Postgres NO usa SSL (por defecto se activa salvo en localhost)
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# OSRM_URL=https://router.project-osrm.org

# Geoapify Places (opcional, recomendado): fuente principal de talleres, grifos y miradores.
# Plan gratuito sin tarjeta: https://www.geoapify.com  (3.000 créditos/día; una ruta consume ~3 por cada 170 km).
# Si falta o falla, la app usa Overpass (OpenStreetMap) como respaldo.
GEOAPIFY_API_KEY=
